<?xml version="1.0" encoding="utf-8"?>
<!-- 横屏布局：相机预览铺满，控制区在右侧竖排 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <!-- CameraX 预览 -->
    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 左上角参数浮层 -->
    <TextView
        android:id="@+id/tvDebugOverlay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="8dp"
        android:background="#80000000"
        android:padding="6dp"
        android:textColor="#FFFF9800"
        android:text="⏳ 正在定位..."
        android:textSize="11sp"
        android:fontFamily="monospace" />

    <!-- 右侧控制面板 -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="end|center_vertical"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="8dp">

        <!-- 已拍数量 -->
        <TextView
            android:id="@+id/tvPhotoCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#80000000"
            android:padding="6dp"
            android:textColor="@android:color/white"
            android:textSize="12sp"
            android:text="已拍: 0" />

        <!-- 快门按钮 -->
        <FrameLayout
            android:id="@+id/shutterBtn"
            android:layout_width="68dp"
            android:layout_height="68dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_shutter_outer"
            android:elevation="6dp"
            android:clickable="true"
            android:focusable="true">

            <View
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_shutter_inner" />
        </FrameLayout>

        <!-- 完成按钮 -->
        <Button
            android:id="@+id/btnSaveTask"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginTop="12dp"
            android:text="完成"
            android:textSize="12sp"
            android:textColor="@android:color/white"
            android:backgroundTint="#4CAF50"
            android:visibility="gone" />
    </LinearLayout>

    <!-- 快门闪光覆盖层 -->
    <View
        android:id="@+id/shutterFlashOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/white"
        android:alpha="0"
        android:clickable="false"
        android:focusable="false" />

</FrameLayout>
