<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <!-- ═══ 1. 地图铺满全屏（底层） ═══ -->
    <com.amap.api.maps.MapView
        android:id="@+id/map"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ═══ 2. 导航信息浮层（地图上方，仅导航时显示） ═══ -->
    <LinearLayout
        android:id="@+id/layout_nav_info"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="56dp"
        android:orientation="vertical"
        android:padding="14dp"
        android:background="@drawable/card_background"
        android:visibility="gone"
        android:elevation="6dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_nav_distance"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="?android:attr/textColorPrimary"
                android:text="0m" />

            <TextView
                android:id="@+id/tv_nav_duration"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="?android:attr/textColorPrimary"
                android:text="0分钟"
                android:gravity="end" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_nav_instruction"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="15sp"
            android:textColor="?android:attr/textColorSecondary"
            android:layout_marginTop="6dp" />
    </LinearLayout>

    <!-- ═══ 3. 定位按钮（地图右下角） ═══ -->
    <ImageButton
        android:id="@+id/btn_my_location"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/card_background"
        android:src="@android:drawable/ic_menu_mylocation"
        android:tint="?android:attr/textColorPrimary"
        android:elevation="4dp"
        android:contentDescription="定位"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/voice_zone" />

    <!-- 金造村路线选择开关（参观模式下显示） -->
    <LinearLayout
        android:id="@+id/jinzao_route_selector"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="8dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:visibility="visible"
        app:layout_constraintBottom_toTopOf="@id/voice_zone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="起义广场"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:layout_marginEnd="12dp" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switch_jinzao_route"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:textOn=""
            android:textOff="" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="司令部旧址"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:layout_marginStart="12dp" />

    </LinearLayout>

    <!-- ═══ 4. 底部语音交互区域（屏幕下 1/4，半透明圆角卡片） ═══ -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/voice_zone"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="24dp"
        app:cardCornerRadius="32dp"
        app:cardElevation="4dp"
        app:strokeWidth="0dp"
        app:cardBackgroundColor="#99000000"
        app:layout_constraintHeight_percent="0.22"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingHorizontal="20dp"
            android:paddingVertical="12dp">

            <!-- 取消指示箭头（平时隐藏，上滑时显示） -->
            <ImageView
                android:id="@+id/iv_cancel_indicator"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@android:drawable/arrow_up_float"
                android:tint="#FF4444"
                android:visibility="gone"
                app:layout_constraintBottom_toTopOf="@id/tv_voice_hint"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                android:layout_marginBottom="8dp" />

            <!-- 语音状态提示文字 -->
            <TextView
                android:id="@+id/tv_voice_hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="按住说话"
                android:textSize="18sp"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:elevation="4dp"
                app:layout_constraintBottom_toTopOf="@id/voice_wave_background"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                android:layout_marginBottom="8dp" />

            <!-- 声波可视化（平时隐藏，录音时显示） -->
            <com.example.voicenavigation.animation.VoiceWaveView
                android:id="@+id/voice_wave_background"
                android:layout_width="200dp"
                android:layout_height="40dp"
                android:visibility="gone"
                app:layout_constraintBottom_toTopOf="@id/tv_voice_sub_hint"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                android:layout_marginBottom="6dp" />

            <!-- 副提示文字 -->
            <TextView
                android:id="@+id/tv_voice_sub_hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="松开发送 · 上滑取消"
                android:textSize="11sp"
                android:textColor="#99FFFFFF"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- ═══ 5. 搜索建议列表（语音搜索后浮动显示） ═══ -->
    <androidx.cardview.widget.CardView
        android:id="@+id/card_suggestions"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="56dp"
        android:layout_marginBottom="200dp"
        android:visibility="gone"
        app:cardCornerRadius="12dp"
        app:cardElevation="6dp"
        app:cardBackgroundColor="?attr/colorSurface"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constrainedHeight="true">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_suggestions"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="4dp"
            android:clipToPadding="false"
            android:scrollbars="vertical" />
    </androidx.cardview.widget.CardView>

    <!-- ═══ 隐藏区域：原功能容器（保留 ID，0dp + alpha=0，inflate 但不可见） ═══ -->
    <FrameLayout
        android:id="@+id/container_pages"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <include android:id="@+id/page_history" layout="@layout/page_history"
            android:layout_width="match_parent" android:layout_height="match_parent" />
        <include android:id="@+id/page_settings" layout="@layout/page_settings"
            android:layout_width="match_parent" android:layout_height="match_parent" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/bottom_controls"
        android:layout_width="0dp" android:layout_height="0dp"
        android:alpha="0" android:importantForAccessibility="no"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">
        <Button android:id="@+id/btn_start_navigation" android:layout_width="0dp" android:layout_height="0dp" />
        <Button android:id="@+id/btn_preview_route" android:layout_width="0dp" android:layout_height="0dp" />
        <Button android:id="@+id/btn_vision_test" android:layout_width="0dp" android:layout_height="0dp" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/search_bar_container"
        android:layout_width="0dp" android:layout_height="0dp" android:alpha="0">
        <EditText android:id="@+id/et_destination" android:layout_width="0dp" android:layout_height="0dp" />
        <ImageButton android:id="@+id/btn_clear_search" android:layout_width="0dp" android:layout_height="0dp" />
    </FrameLayout>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_nav"
        android:layout_width="0dp" android:layout_height="0dp"
        android:alpha="0" android:importantForAccessibility="no"
        app:menu="@menu/menu_main_bottom" />

    <!-- 停止语音按钮（浮动在语音卡片上方，播报时出现） -->
    <Button
        android:id="@+id/btn_stop_tts"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:paddingHorizontal="20dp"
        android:text="停止语音"
        android:textColor="@color/white"
        android:textSize="14sp"
        android:background="@color/gray"
        android:elevation="4dp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/voice_zone"
        android:layout_marginBottom="8dp"
        android:layout_marginEnd="16dp" />

</androidx.constraintlayout.widget.ConstraintLayout>
